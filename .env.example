# ============================================================
# VARIÁVEIS OBRIGATÓRIAS
# ============================================================

# Senha do banco de dados MySQL
DB_PASSWORD=sua_senha_do_mysql

# Chave secreta para gerar tokens JWT
# Deve ter no mínimo 32 caracteres
# Exemplo: use `openssl rand -base64 32` para gerar uma chave forte
JWT_SECRET=uma_chave_bem_grande_com_32_ou_mais_caracteres_aqui

# Chave da API de OCR (para ler imagens de notas fiscais)
OCR_API_KEY=sua_chave_da_api_ocr

# ============================================================
# VARIÁVEIS OPCIONAIS (tem valor padrão)
# ============================================================

# Endereço do banco de dados
# Padrão: jdbc:mysql://localhost:3306/adega_underground
# DB_URL=jdbc:mysql://localhost:3306/adega_underground

# Usuário do banco de dados
# Padrão: root
# DB_USERNAME=root

# Como o Hibernate gerencia as tabelas
# Opções: validate, update, create, create-drop
# validate = não cria/altera tabelas (apenas verifica)
# update = cria/altera tabelas conforme as entidades (bom para dev)
# Padrão: validate
# JPA_DDL_AUTO=validate

# Mostrar SQL no console
# Padrão: false
# JPA_SHOW_SQL=false

# Ligar o Swagger (documentação interativa da API)
# Padrão: false
# SWAGGER_ENABLED=false

# Deixar o Swagger acessível publicamente
# Padrão: false
# SWAGGER_PUBLIC=false

# Origens liberadas para requisições do front-end (CORS)
# Padrão: http://localhost:5173
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# Quantas horas o token JWT fica válido
# Padrão: 2
# JWT_EXPIRATION_HOURS=2

# Tamanho máximo de arquivo para OCR (em bytes)
# Padrão: 5242880 (5MB)
# OCR_MAX_FILE_SIZE_BYTES=5242880

# URL da API de OCR
# Padrão: https://api.ocr.space/parse/image
# OCR_URL=https://api.ocr.space/parse/image
