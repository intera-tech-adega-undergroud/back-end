{
  "item": [
    {
      "name": "Login e Funcionários",
      "item": [
        {
          "name": "Entrar (faça primeiro)",
          "request": {
            "description": "Preencha email e senhaCripto de uma conta existente. Envie esta requisição primeiro: o token será usado automaticamente nas demais. Não coloque aspas extras no token.",
            "url": {
              "path": [
                "funcionarios",
                "login"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "*/*"
              }
            ],
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"postman.local@example.com\",\n  \"senhaCripto\": \"\"\n}",
              "options": {
                "raw": {
                  "headerFamily": "json",
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    pm.collectionVariables.set(\"token\", pm.response.json().token);",
                  "} else {",
                  "    pm.collectionVariables.unset(\"token\");",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Cadastrar funcionário",
          "request": {
            "description": "Exemplo pronto para editar. Confira os dados antes de enviar. Preencha senha com 8 a 72 caracteres, incluindo maiúscula, número e símbolo. CPF/contato são fictícios: substitua por dados de teste adequados. A conta conectada precisa de usuarios_criar. Escolha as permissões que deseja conceder.",
            "url": {
              "path": [
                "funcionarios"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "*/*"
              }
            ],
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Operador\",\n  \"sobrenome\": \"Teste\",\n  \"cpf\": \"00000000000\",\n  \"email\": \"operador.teste@example.com\",\n  \"celular\": \"11999990000\",\n  \"senha\": \"\",\n  \"permissoes\": [\n    \"estoque_visualizar\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          }
        }
      ]
    },
